    def save_model_safely(self, model, model_path):
        """Safely save a model to avoid HDF5 file issues."""
        try:
            if os.path.exists(model_path):
                os.remove(model_path)
            model.save(model_path, save_format='h5')
            with h5py.File(model_path, 'a') as f:
                f.flush()
        except Exception as e:
            self.log_file.write(json.dumps(
                {"formatted_time": datetime.now().strftime("%H:%M:%S"), "event": "model_save_error",
                 "message": str(e)}) + '\n')
            print(f"Failed to save model {model_path}: {e}")

    def train_physics_model(self):
        """Train a CNN for physics-based motion anomaly detection."""
        model_path = 'physics_model.h5'
        if os.path.exists(model_path):
            try:
                return tf.keras.models.load_model(model_path)
            except:
                os.remove(model_path)
        model = tf.keras.Sequential([
            tf.keras.layers.Conv2D(32, (3, 3), activation='relu', input_shape=(224, 224, 3)),
            tf.keras.layers.MaxPooling2D((2, 2)),
            tf.keras.layers.Conv2D(64, (3, 3), activation='relu'),
            tf.keras.layers.MaxPooling2D((2, 2)),
            tf.keras.layers.Conv2D(64, (3, 3), activation='relu'),
            tf.keras.layers.Flatten(),
            tf.keras.layers.Dense(64, activation='relu'),
            tf.keras.layers.Dense(1, activation='sigmoid')
        ])
        model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
        X_train = np.random.rand(100, 224, 224, 3)
        y_train = np.random.randint(0, 2, (100,))
        model.fit(X_train, y_train, epochs=5, batch_size=32, verbose=1)
        self.save_model_safely(model, model_path)
        print("Physics model trained and saved.")
        return model

