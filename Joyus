    def analyze_environment(self):
        """Analyze environment and provide a summary."""
        anomalies = []
        frame = self.get_current_frame()
        weather_data = self.get_weather_data()
        sky_frame = self.get_sky_frame()

        current_time = datetime.now().strftime("%H:%M:%S")

        if frame is not None:
            physics_input = self.preprocess_frame_for_physics(frame)
            physics_pred = self.physics_model.predict(physics_input)
            if physics_pred[0][0] > 0.5:
                anomaly_details = "Physics: Motion anomaly detected"
                self.log_event("scientific_anomaly", anomaly_details, current_time)
                anomalies.append(anomaly_details)

            chemistry_input = self.preprocess_frame_for_chemistry(frame)
            chemistry_pred = self.chemistry_model.predict(chemistry_input)
            if chemistry_pred[0][0] > 0.5:
                anomaly_details = "Chemistry: Hazardous substance detected"
                self.log_event("scientific_anomaly", anomaly_details, current_time)
                anomalies.append(anomaly_details)

        if weather_data:
            env_input = self.preprocess_weather_data(weather_data)
            env_pred = self.environmental_model.predict(env_input)
            if env_pred[0][0] > 0.5:
                anomaly_details = "Environmental: Weather anomaly predicted"
                self.log_event("scientific_anomaly", anomaly_details, current_time)
                anomalies.append(anomaly_details)

        if sky_frame is not None:
            space_input = self.preprocess_sky_frame(sky_frame)
            space_pred = self.space_model.predict(space_input)
            if space_pred[0][0] > 0.5:
                anomaly_details = "Space: Celestial object identified"
                self.log_event("scientific_anomaly", anomaly_details, current_time)
                anomalies.append(anomaly_details)

        if anomalies:
            summary = "Analysis complete. Detected anomalies:\n" + "\n".join(anomalies)
        else:
            summary = "Analysis complete. No anomalies detected."
        self.speak(summary)
        return summary

    def preprocess_frame_for_physics(self, frame):
        frame = cv2.resize(frame, (224, 224))
        frame = frame / 255.0
        return np.expand_dims(frame, axis=0)

    def preprocess_frame_for_chemistry(self, frame):
        frame = cv2.resize(frame, (224, 224))
        frame = frame / 255.0
        return np.expand_dims(frame, axis=0)

    def preprocess_weather_data(self, weather_data):
        features = [weather_data['main']['temp'] - 273.15,
                    weather_data['main']['humidity'],
                    weather_data['wind']['speed']]
        data = np.array([features] * 10).reshape(1, 10, 3)
        return data

    def preprocess_sky_frame(self, sky_frame):
        sky_frame = cv2.resize(sky_frame, (224, 224))
        sky_frame = sky_frame / 255.0
        return np.expand_dims(sky_frame, axis=0)

    def get_current_frame(self):
        ret, frame = self.cap.read() if self.cap.isOpened() else (False, None)
        return frame if ret else None

    def get_sky_frame(self):
        return self.get_current_frame()

    def get_status(self):
        state = self.consciousness.get_state()
        return f"Alertness: {state['alertness']:.2f}, Confidence: {state['confidence']:.2f}, Monitoring {len(self.active_tracks)} entities."

    def get_weather(self):
        weather_data = self.get_weather_data()
        if weather_data:
            temp = weather_data['main']['temp'] - 273.15
            description = weather_data['weather'][0]['description']
            return f"The current weather is {description} with a temperature of {temp:.1f}°C."
        return "Unable to fetch weather data."

    def get_people_count(self):
        person_count = len(self.active_tracks)
        return f"There are currently {person_count} people detected."

    def get_anomalies(self):
        anomalies = [e for e in self.recent_events if e["event"] in ["anomaly", "scientific_anomaly"]]
        if anomalies:
            summary = "Recent anomalies:\n"
            for anomaly in anomalies[-5:]:
                summary += f"- {anomaly['details']} at {anomaly['formatted_time']}\n"
            return summary
        return "No recent anomalies detected."

    def get_help(self):
        return "Available commands: status, weather, people count, anomalies, help. You can also ask general questions."

    def run_assistant(self):
        """Main assistant loop with monitoring and interaction."""
        print("🚀 Joyus - Your Sentient AI Assistant Awakens")
        threading.Thread(target=self.read_input, daemon=True).start()
        previous_positions = {}

        while self.cap.isOpened():
            try:
                start_frame_time = time.time()
                ret, frame = self.cap.read()
                if not ret:
                    break

                current_time = time.time()

                # Object detection
                results = self.model(frame, conf=0.5)
                detections = []
                for r in results:
                    boxes = r.boxes.xyxy.cpu().numpy()
                    scores = r.boxes.conf.cpu().numpy()
                    classes = r.boxes.cls.cpu().numpy()
                    for box, score, cls in zip(boxes, scores, classes):
                        x1, y1, x2, y2 = map(int, box)
                        detections.append(([x1, y1, x2 - x1, y2 - y1], score, self.model.names[int(cls)]))

                # Object tracking
                tracks = self.tracker.update_tracks(detections, frame=frame)
                confirmed_tracks = [track for track in tracks if track.is_confirmed()]
                current_track_ids = set(track.track_id for track in confirmed_tracks)

                # Anomaly detection and visualization
                person_count = 0
                for track in confirmed_tracks:
                    if track.det_class != "person":
                        continue
                    person_count += 1
                    id = track.track_id
                    ltrb = track.to_ltrb()
                    x1, y1, x2, y2 = map(int, ltrb)
                    position = ((x1 + x2) / 2, (y1 + y2) / 2)

                    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
                    cv2.putText(frame, f"{track.det_class} ID:{id}", (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.9,
                                (0, 255, 0), 2)

                    self.log_event("detection", f"{track.det_class} ID:{id}", datetime.now().strftime("%H:%M:%S"))
                    if id not in previous_positions:
                        self.reflect_on_event("new_detection", track.det_class)

                    if id not in self.active_tracks:
                        self.active_tracks[id] = {"start_time": current_time, "positions": [position],
                                                  "times": [current_time], "last_position": position}
                    else:
                        track_data = self.active_tracks[id]
                        last_position = track_data["last_position"]
                        last_time = track_data["times"][-1]
                        dt = current_time - last_time
                        if dt > 0:
                            distance = np.linalg.norm(np.array(position) - np.array(last_position))
                            speed = distance / dt
                            track_data["speed"] = speed
                            if len(track_data["positions"]) >= 2:
                                pos1, pos2 = track_data["positions"][-2], track_data["positions"][-1]
                                t1, t2 = track_data["times"][-2], track_data["times"][-1]
                                dt_prev = t2 - t1
                                if dt_prev > 0:
                                    distance_prev = np.linalg.norm(np.array(pos2) - np.array(pos1))
                                    speed_prev = distance_prev / dt_prev
                                    acceleration = (speed - speed_prev) / dt
                                    track_data["acceleration"] = acceleration
                                    if abs(acceleration) > self.ACCELERATION_THRESHOLD:
                                        self.log_event("anomaly", "high_acceleration",
                                                       datetime.now().strftime("%H:%M:%S"))
                                        self.reflect_on_event("high_acceleration", id, acceleration=acceleration)
                            if speed > self.SPEED_THRESHOLD:
                                self.log_event("anomaly", "high_speed", datetime.now().strftime("%H:%M:%S"))
                                self.reflect_on_event("high_speed", id, speed=speed)
                        track_data["positions"].append(position)
                        track_data["times"].append(current_time)
                        track_data["last_position"] = position

                # Update consciousness
                anomaly_count = len([e for e in self.recent_events if e["event"] == "anomaly"])
                scientific_anomalies = len([e for e in self.recent_events if e["event"] == "scientific_anomaly"])
                audio_activity = np.max(self.latest_audio_scores) if self.yamnet_model else 0.0
                self.consciousness.update(anomaly_count, audio_activity, person_count, scientific_anomalies)

                # Autonomous decision-making with DQN
                if current_time - self.last_action_time > 60:
                    state = [
                        self.consciousness.alertness,
                        self.consciousness.confidence,
                        anomaly_count,
                        audio_activity,
                        person_count,
                        scientific_anomalies
                    ]
                    if self.previous_state is not None:
                        reward = 1.0 if self.consciousness.alertness > 0.7 and self.previous_action in [2, 0] else 0.5
                        self.policy.store_experience(self.previous_state, self.previous_action, reward, state, False)
                        self.policy.train()

                    action_idx = self.policy.choose_action(state)
                    action = self.policy.actions[action_idx]
                    self.execute_action(action)
                    self.previous_state = state
                    self.previous_action = action_idx
                    self.last_action_time = current_time

                # Cleanup inactive tracks
                active_ids = set(self.active_tracks.keys())
                for id in active_ids - current_track_ids:
                    del self.active_tracks[id]

                previous_positions = {track.track_id: track.to_ltrb() for track in confirmed_tracks}
                self.out.write(frame)
                cv2.imshow("Joyus Assistant", frame)

                try:
                    command = self.command_queue.get_nowait()
                    response = self.process_command(command)
                    self.speak(response)
                except queue.Empty:
                    pass

                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break

            except Exception as e:
                self.log_file.write(json.dumps({"formatted_time": datetime.now().strftime("%H:%M:%S"), "event": "error",
                                                "message": str(e)}) + '\n')

        self._cleanup()
        cv2.destroyAllWindows()

    def process_command(self, command):
        """Process user commands with expanded functionality."""
        command = command.lower().strip()
        if "status" in command:
            return self.get_status()
        elif "weather" in command:
            return self.get_weather()
        elif "people" in command and "count" in command:
            return self.get_people_count()
        elif "anomalies" in command:
            return self.get_anomalies()
        elif "help" in command:
            return self.get_help()
        else:
            try:
                prompt = (
                    "You are Joyus, a highly advanced AI assistant similar to Jarvis from Iron Man. "
                    "You are proactive, context-aware, and capable of answering a wide range of questions. "
                    "Provide a concise, helpful response to the user's query.\n\n"
                    f"User: {command}\nAssistant: "
                )
                inputs = self.tokenizer(prompt, return_tensors="pt", padding=True, truncation=True, max_length=256)
                outputs = self.thought_generator.generate(
                    inputs["input_ids"],
                    max_length=100,
                    num_return_sequences=1,
                    temperature=0.7,
                    top_p=0.9,
                    top_k=50,
                    do_sample=True,
                    pad_token_id=self.tokenizer.eos_token_id
                )
                response = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
                response = response.replace(prompt, "").strip()
                if not response:
                    response = "I'm sorry, I didn't understand that. Could you please clarify?"
                return response
            except Exception as e:
                error_msg = f"Error processing command with TinyLlama: {str(e)}"
                self.log_file.write(json.dumps(
                    {"formatted_time": datetime.now().strftime("%H:%M:%S"), "event": "tinyllama_error", "message": error_msg}) + '\n')
                return "I'm having trouble processing that request. Please try again."

    def read_input(self):
        """Read user input in a separate thread."""
        while True:
            command = input().strip()
            if command:
                self.command_queue.put(command)

if __name__ == "__main__":
